{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eisenhowerj/garmin-swimmy/schemas/workout-v1.json",
  "title": "Swimmy Workout v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "kind", "name", "blocks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "kind": { "enum": ["preset", "custom"] },
    "name": { "type": "string", "minLength": 1, "maxLength": 48 },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/block" }
    }
  },
  "$defs": {
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distanceMeters", "repetitions", "restSeconds"],
      "properties": {
        "distanceMeters": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "repetitions": { "type": "integer", "minimum": 1, "maximum": 100 },
        "restSeconds": { "type": "integer", "minimum": 0, "maximum": 3600 }
      }
    }
  }
}
